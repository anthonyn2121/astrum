# ASTRUM C++ style: Google, widened to 100 columns. Applies to every tracked
# C++ file (controllers, the astrum-fdm JSBSim shim, docker/checks) via
# `make fmt` / `make fmt-check`; the Rust side is formatted by rustfmt
# (see rustfmt.toml).
BasedOnStyle: Google
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
