# Rust
/target/
**/*.rs.bk

# Build output (C++ controllers build into /build/controllers; any nested
# CMake build dir is covered too)
**/build/

# Python bytecode / tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv-cache/

# Env / local overrides
.env
docker-compose.override.yml
config/scenario.toml
.claude/

# Recordings, replays, training runs, cached map tiles (local data)
/recordings/
/replays/
/runs/
/tilecache/
*.mcap
*.bag

# Local experiment workspaces (not part of the repo)
/controllers/rl/
/controllers/race/
/.jsbsim-variants/

# JSBSim CLI output (default `JSBout<model>.csv`, written to the CWD)
JSBout*.csv

# Editor / OS
*.log
.DS_Store
